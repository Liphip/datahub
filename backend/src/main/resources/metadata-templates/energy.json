{
  "key": "energy",
  "name": "Energy: meters, locations, grid areas",
  "description": "Meters and their metering/market locations (MeLo/MaLo), sites, low-voltage grid areas and controllable consumption devices — e.g. for readings from LoRaWAN meters, meter master data from SAP and grid-oriented control (§14a EnWG).",
  "types": [
    {"typeKey": "lorawan_device", "name": "LoRaWAN device",
     "identifierSchemes": [{"scheme": "lorawan.devEUI", "name": "DevEUI", "pattern": "^[0-9A-Fa-f]{16}$"}],
     "attributeSchema": [{"name": "model", "type": "string"}, {"name": "application", "type": "string"}],
     "relationSchema": [{"relation": "meter", "targetType": "meter"}]},
    {"typeKey": "meter", "name": "Meter",
     "identifierSchemes": [{"scheme": "meter_number", "name": "Meter number"}, {"scheme": "sap.equipment", "name": "SAP equipment"}],
     "attributeSchema": [{"name": "manufacturer", "type": "string"}, {"name": "meterType", "type": "string", "description": "e.g. mME, iMSys, RLM"}, {"name": "phases", "type": "number"}],
     "relationSchema": [{"relation": "metering_location", "targetType": "metering_location"}]},
    {"typeKey": "metering_location", "name": "Metering location (MeLo)",
     "identifierSchemes": [{"scheme": "melo", "name": "MeLo-ID", "pattern": "^DE[0-9A-Z]{31}$"}],
     "attributeSchema": [{"name": "voltageLevel", "type": "string"}],
     "relationSchema": [{"relation": "market_location", "targetType": "market_location", "many": true}]},
    {"typeKey": "market_location", "name": "Market location (MaLo)",
     "identifierSchemes": [{"scheme": "malo", "name": "MaLo-ID", "pattern": "^[0-9]{11}$"}],
     "attributeSchema": [{"name": "direction", "type": "string", "description": "consumption or generation"}, {"name": "supplier", "type": "string"}],
     "relationSchema": [{"relation": "location", "targetType": "location"}]},
    {"typeKey": "location", "name": "Location",
     "identifierSchemes": [{"scheme": "location_id", "name": "Location ID"}],
     "attributeSchema": [{"name": "street", "type": "string"}, {"name": "postalCode", "type": "string"}, {"name": "city", "type": "string"}, {"name": "lat", "type": "number"}, {"name": "lon", "type": "number"}],
     "relationSchema": [{"relation": "grid_area", "targetType": "grid_area"}]},
    {"typeKey": "grid_area", "name": "Grid area (low voltage)",
     "identifierSchemes": [{"scheme": "grid_area_id", "name": "Grid area ID"}],
     "attributeSchema": [{"name": "transformerStation", "type": "string"}, {"name": "postalCode", "type": "string", "description": "Postal code of the transformer station"}, {"name": "gridConnections", "type": "number"}],
     "relationSchema": []},
    {"typeKey": "controllable_device", "name": "Controllable consumption device",
     "identifierSchemes": [{"scheme": "device_id", "name": "Device ID"}],
     "attributeSchema": [{"name": "category", "type": "string", "description": "wallbox, heat_pump, cooling, storage"}, {"name": "connectionPowerKw", "type": "number"}, {"name": "controlMode", "type": "string", "description": "direct or ems"}, {"name": "commissioned", "type": "date"}],
     "relationSchema": [{"relation": "market_location", "targetType": "market_location"}]}
  ]
}
